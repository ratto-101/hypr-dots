* {
bg:        #282828;
bg-alt:    #32302f;
bg-elev:   #3c3836;
fg:        #ebdbb2;
aqua:      #8ec07c;
yellow:    #fabd2f;
border:    #504945;

background-color: transparent;
text-color:       @fg;
font:             "Iosevka Nerd Font Propo 10";
}

window {
    location: north;
    anchor: north;
    y-offset: 38px;
background-color: @bg;
border:           2px;
border-color:     @border;
border-radius:    10px;
padding:          14px;
width:            900px;
}

mainbox {
spacing:  10px;
children: [ inputbar, listview ];
}

inputbar {
background-color: @bg-alt;
border:           1px;
border-color:     @border;
border-radius:    8px;
padding:          8px 12px;
children:         [ prompt, entry ];
}

prompt {
text-color: @aqua;
padding:    0 8px 0 0;
}

entry {
text-color:  @fg;
placeholder: "Pick wallpaper...";
}

listview {
columns:       3;
lines:         2;
fixed-height:  true;
spacing:       10px;
}

element {
orientation:   vertical;
padding:       8px;
border-radius: 8px;
}

element normal.normal,
element alternate.normal {
background-color: @bg-alt;
text-color:       @fg;
}

element selected.normal {
background-color: @bg-elev;
text-color:       @yellow;
border:           1px;
border-color:     @aqua;
}

element-icon {
size:             140px;
horizontal-align: 0.5;
}

element-text {
horizontal-align: 0.5;
padding:          6px 0 0 0;
}
