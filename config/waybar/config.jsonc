{
    "layer": "top",
    "width": 1300,
    "modules-left": [
        "pulseaudio",
        "cava"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/tray-drawer",
        "network",
        "clock",
        "battery",
        "custom/wallpaper"
    ],

// wallpaper shit
"custom/wallpaper": {
    "format": "󰸉",
    "tooltip-format": "Choose wallpaper (Waypaper)",
    "on-click": "pkill -x waypaper || waypaper"
},


    // theres no bluetooth icon for a reason

    // network icon — auto-detects wifi/ethernet (removed hardcoded wlan* interface)
"network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}: {essid} ({signalStrength}%)",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.local/bin/wifi-menu"
},

// tray drawer thingy
"group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-arrow",
            "tray"
        ]
    },

    "custom/tray-arrow": {
        "format": "",
        "tooltip": "Toggle tray icons"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },


// battery icon duh
"battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },



// clock icon 
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a, %d. %b  %I:%M %p}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },


        // see that cool music visualizer? yeah that's this thing 
        
            "cava": {
                //"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
                "framerate": 60,
                "autosens": 0,
                "sensitivity": 6,
                "bars": 12,
                "lower_cutoff_freq": 50,
                "higher_cutoff_freq": 10000,
                "method": "pipewire",
                "source": "auto",
                "stereo": false,
                "reverse": false,
                "monstercat": false,
                "waves": false,
                "noise_reduction": 0.27,
                "input_delay": 6,
                "sleep_timer": 5,       
                "bar_delimiter": 0,
                "format-icons": [
                    "▁",
                    "▂",
                    "▃",
                    "▄",
                    "▅",
                    "▆",
                    "▇",
                    "█"
                ],
                "actions": {
                    "on-click-right": "mode"
                }
            }
        }
