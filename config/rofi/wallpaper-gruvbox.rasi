* {
    bg0:     #1d2021;
    bg1:     #0a0808;
    bg2:     #262a2b;
    bg3:     #45403d;
    fg:      #d4be98;
    yellow:  #d8a657;
    grey1:   #928374;

    font: "Electroharmonix 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: northwest;
    x-offset: 310px;
    y-offset: 0px;
    width: 720px;
    background-color: #1d2021;
    border-radius: 0px 0px 14px 14px;
    padding: 12px;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg0;
    border-radius: 10px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @yellow;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Search wallpaper...";
    placeholder-color: @grey1;
}

listview {
    columns: 3;
    lines: 2;
    fixed-height: true;
    scrollbar: false;
    spacing: 10px;
}

element {
    orientation: vertical;
    padding: 10px;
    border-radius: 10px;
    background-color: @bg0;
    spacing: 6px;
}

element-icon {
    size: 128px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
}

element selected {
    background-color: @yellow;
    text-color: @bg0;
}
